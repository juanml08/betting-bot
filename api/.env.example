# Entorno de la aplicacion
APP_ENV=development
LOG_LEVEL=INFO

# Base de datos MySQL
DATABASE_URL=mysql+pymysql://betting_user:betting_password@localhost:3306/betting_bot

# Gestion de riesgo / banca
