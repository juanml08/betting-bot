# URL base de la API FastAPI.
# Vacia = mismo origen: en desarrollo lo resuelve el proxy de Vite (vite.config.ts)
# y en produccion el servidor que sirva el frontend junto a la API.
# Para apuntar directo al backend (requiere CORS habilitado en la API):
# VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=

# Destino del proxy de desarrollo de Vite hacia el backend.
VITE_API_PROXY_TARGET=http://localhost:8000
